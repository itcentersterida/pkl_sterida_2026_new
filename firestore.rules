rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['itcentersterida@gmail.com', 'irfanpriyono68@guru.smk.belajar.id'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isSupervisor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // users Collection
    // Admins can read and write all users. Signed-in users can read profiles to sync details. Users can manage their own profiles.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(userId) || 
        (isSignedIn() && request.auth.token.email != null && request.auth.token.email.toLowerCase() == userId);
    }

    // locations Collection
    // Anyone signed in can read (to choose/view locations), only admin can manage/write
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // assignments Collection
    // Admin, supervisor and the student assigned can manage/read assignments
    match /assignments/{assignmentId} {
      allow read, write: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (resource.data.studentId == request.auth.uid || resource.data.supervisorId == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.studentId == request.auth.uid || request.resource.data.supervisorId == request.auth.uid))
      );
    }

    // attendance Collection
    // Admin, supervisor, and the respective student can read/write attendance records
    match /attendance/{attendanceId} {
      allow read, write: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        (resource != null && resource.data.studentId == request.auth.uid) ||
        (request.resource != null && request.resource.data.studentId == request.auth.uid)
      );
    }

    // journals Collection
    // Admin, supervisor, and the respective student can read/write journal entries
    match /journals/{journalId} {
      allow read, write: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        (resource != null && resource.data.studentId == request.auth.uid) ||
        (request.resource != null && request.resource.data.studentId == request.auth.uid)
      );
    }

    // activityLogs Collection
    // Admin, supervisor, and respective user can manage activity logs
    match /activityLogs/{logId} {
      allow read, write: if isSignedIn() && (
        isAdmin() ||
        isSupervisor() ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
